{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nidhinetra.local/contracts/fund_flow_graph.schema.json",
  "title": "FundFlowGraph",
  "description": "Execution Plan section 3.3. Produced by A3, consumed by A4. Only meaningful at national scale -- see NidhiNetra Viva Brief part 7. M5 is conditional on implementing_agency and vendor_name surviving the data spike across 8-plus states (eng review, Design Review - Data Spike First).",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "risk_weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["MP", "Agency", "Vendor"] },
          "label": { "type": "string", "minLength": 1 },
          "risk_weight": { "type": "number", "minimum": 0 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "work_count",
          "total_amount_inr",
          "flagged_work_count",
          "work_ids"
        ],
        "properties": {
          "source": { "type": "string", "minLength": 1, "description": "Must match a node id" },
          "target": { "type": "string", "minLength": 1, "description": "Must match a node id" },
          "work_count": { "type": "integer", "minimum": 1 },
          "total_amount_inr": { "type": "number", "minimum": 0 },
          "flagged_work_count": { "type": "integer", "minimum": 0 },
          "work_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true,
            "description": "F-02 (nemotronreview.md), fixed 2026-09-14: every real work_id backing this edge. An MP->Agency and an Agency->Vendor edge represent a real fund-flow path only if their work_ids intersect -- consumers must never infer a path from source/target adjacency alone (see web/lib/vendor-concentration.ts)."
          }
        }
      }
    }
  }
}
